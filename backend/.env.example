NODE_ENV=development
PORT=5000
MONGODB_URI=
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=info

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AI_ROUTE_RATE_LIMIT_WINDOW_MS=900000
AI_ROUTE_RATE_LIMIT_MAX=20
REFRESH_COOKIE_NAME=relay_refresh_token
GOOGLE_CLIENT_ID=
SEED_USER_PASSWORD=

REDIS_URL=
DEADLINE_MONITOR_ENABLED=true
DEADLINE_MONITOR_INTERVAL_MS=3600000
DEADLINE_UPCOMING_HOURS=24
AI_JOB_STREAM=relay:ai:jobs
AI_RESULT_STREAM=relay:ai:results
AI_DEAD_LETTER_STREAM=relay:ai:dead-letter
AI_JOB_SCHEMA_VERSION=1
AI_RESULT_SCHEMA_VERSION=1
AI_WORKER_CONSUMER_GROUP=relay-ai-workers
AI_RESULT_CONSUMER_GROUP=relay-api-results
AI_RESULT_CONSUMER_NAME=
AI_PENDING_IDLE_MS=30000
AI_CONSUMER_RETRY_BASE_MS=500
AI_CONSUMER_RETRY_MAX_MS=30000
DUPLICATE_MEDIUM_THRESHOLD=0.80
DUPLICATE_HIGH_THRESHOLD=0.90
AUDIO_STORAGE_DIR=.relay-data/audio
AUDIO_MAX_BYTES=25000000
AUDIO_STORAGE_PROVIDER=local
API_PUBLIC_URL=http://localhost:5000
AUDIO_SIGNING_SECRET=replace-with-a-different-random-secret-at-least-32-characters
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_COMPLETION_TOKENS=800
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_LANGUAGE=
GROQ_TRANSCRIPTION_TIMEOUT_SECONDS=120
TRANSCRIPT_CHUNK_MAX_CHARS=12000
TRANSCRIPT_CHUNK_OVERLAP_SEGMENTS=1
TRANSCRIPT_CHUNK_CONCURRENCY=3
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
MONGODB_DATABASE=
ATLAS_VECTOR_INDEX=task_embedding_index
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
