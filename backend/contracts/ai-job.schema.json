{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/contracts/ai-job.schema.json",
  "title": "Relay AI Job Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "jobType",
    "schemaVersion",
    "projectId",
    "initiatingUserId",
    "createdAt",
    "payload"
  ],
  "properties": {
    "jobId": { "type": "string", "minLength": 1 },
    "jobType": {
      "type": "string",
      "enum": ["meeting.process", "meeting.reprocess", "command.interpret"]
    },
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "initiatingUserId": { "type": "string", "minLength": 1 },
    "resourceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
